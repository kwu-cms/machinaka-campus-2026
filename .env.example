# コピーして使う: cp .env.example .env（.env は Git に含めません）
#
# スプレッドシート CSV エクスポート URL（未設定時は js/config.shared.js の SHEET_DATA_URLS）
SHEET_EVENTS_URL=https://docs.google.com/spreadsheets/d/1hXldiXUl2klbJe6v7BraKEFCXL8cxd5WAjc0RRNzlPo/export?format=csv&gid=651546877
SHEET_MOVIES_URL=https://docs.google.com/spreadsheets/d/1hXldiXUl2klbJe6v7BraKEFCXL8cxd5WAjc0RRNzlPo/export?format=csv&gid=1499163471
SHEET_SPEAKERS_URL=https://docs.google.com/spreadsheets/d/1hXldiXUl2klbJe6v7BraKEFCXL8cxd5WAjc0RRNzlPo/export?format=csv&gid=1429540203
SHEET_EXHIBITIONS_URL=https://docs.google.com/spreadsheets/d/1hXldiXUl2klbJe6v7BraKEFCXL8cxd5WAjc0RRNzlPo/export?format=csv&gid=1913009152

# Heteml テストサーバー（npm run deploy:heteml）
# SSH の Host 名（~/.ssh/config）または user@host.example.com
HETEML_SSH=ssh-your-account.heteml.net
HETEML_REMOTE_PATH=/home/users/0/your-account/web/example/path
HETEML_SSH_PORT=2222
# 任意: 秘密鍵パス（未設定時は ssh-agent / デフォルト鍵）
# SSH_KEY_PATH=~/.ssh/id_ed25519

# GitHub Pages 本番 OGP 用（npm run build:prod の SITE_ORIGIN 上書き）
SITE_ORIGIN=https://kwu-cms.github.io/machinaka-campus-2026
